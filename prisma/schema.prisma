datasource db { provider = "postgresql" url = env("DATABASE_URL") }
generator client { provider = "prisma-client-js" }

enum VolunteerStatus { PENDING ACTIVE INACTIVE }
enum IssueStatus { NEW REVIEWING ASSIGNED IN_PROGRESS RESOLVED }
enum ContactType { GENERAL VOLUNTEER MEDIA EVENT COMMUNITY OTHER }

model Volunteer {
  id String @id @default(cuid())
  name String
  phone String
  email String?
  location String?
  ward String?
  role String?
  skills String?
  availability String?
  consent Boolean @default(false)
  status VolunteerStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id String @id @default(cuid())
  name String
  phone String?
  email String?
  location String?
  type ContactType @default(GENERAL)
  subject String?
  message String
  status String @default("NEW")
  createdAt DateTime @default(now())
}

model Event {
  id String @id @default(cuid())
  title String
  description String
  location String
  startsAt DateTime
  registrationUrl String?
  published Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsPost {
  id String @id @default(cuid())
  title String
  excerpt String
  content String
  imagePath String?
  published Boolean @default(false)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
